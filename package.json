{
  "name": "haptic",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check",
    "lint:oxc": "oxlint --config oxlint.config.mjs",
    "format": "oxfmt",
    "format:check:oxc": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@strastdas/oxc-config": "^0.1.3",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.5.0",
    "ultracite": "^7.9.4"
  },
  "packageManager": "pnpm@10.33.4",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,svelte}": [
      "oxlint --config oxlint.config.mjs --fix"
    ],
    "*.{js,mjs,cjs,ts,json}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
